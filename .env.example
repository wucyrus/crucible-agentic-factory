# Core
REPO_NAME=crucible-agentic-factory
REPO_HANDLE=caf
ENVIRONMENT=dev

# Edge and routing
EDGE_DOMAIN=example.com
EDGE_TLS_EMAIL=admin@example.com
EDGE_ACCESS_LOG_LEVEL=INFO
EDGE_RUNTIME_LOG_LEVEL=WARN

# Agent/runtime defaults
DEFAULT_MODEL_PROVIDER=codex
DEFAULT_WORKTREE_ROOT=./worktrees
DEFAULT_MEMORY_ROOT=./services/memory
