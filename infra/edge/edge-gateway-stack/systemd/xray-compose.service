[Unit]
Description=Xray Server (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# IMPORTANT:
# Update this path to the server location that contains docker-compose.yml.
# Example: /opt/xray/edge-gateway-stack
WorkingDirectory=/opt/xray/server

ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
