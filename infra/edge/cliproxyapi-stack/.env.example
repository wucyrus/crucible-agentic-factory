# Optional runtime overrides for the CLIProxyAPI container.
# Copy to .env only if you need to override defaults.

# CLI_PROXY_IMAGE=eceasy/cli-proxy-api:latest
# DEPLOY=

# Optional overrides for CPA Usage Keeper.
# CPA_USAGE_KEEPER_IMAGE=ghcr.io/willxup/cpa-usage-keeper:latest
# KEEPER_HOST_PORT=18080
# TZ=Asia/Shanghai
# CPA_BASE_URL=http://cli-proxy-api:8317
# CPA_MANAGEMENT_KEY=replace-with-your-management-key
# CPA_PUBLIC_URL=http://127.0.0.1:8317
# AUTH_ENABLED=true
# LOGIN_PASSWORD=replace-with-your-login-password
# REDIS_QUEUE_ADDR=
