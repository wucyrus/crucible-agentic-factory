# Replace with your own hostname before use.
third.example.com {
    log {
        level {$CADDY_LOG_LEVEL}
    }

    @root_path {
        path /
    }

    @allowed_paths {
        path /v1/*
        path /v0/management/usage
    }

    @v1_missing_auth {
        path /v1*
        not header Authorization *
        not header X-Api-Key *
        not header X-API-Key *
        not header X-Goog-Api-Key *
    }

    @v0_missing_auth {
        path /v0*
        not header Authorization *
    }

    route {
        handle @root_path {
            root * /var/www/honeypot
            file_server
            try_files {path} /index.html
        }

        handle @allowed_paths {
            reverse_proxy 127.0.0.1:8317 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }

        handle @v1_missing_auth {
            reverse_proxy 127.0.0.1:9090 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up User-Agent {header.User-Agent}
                header_up Host {host}
                header_up X-Original-URI {uri}
            }
        }

        handle @v0_missing_auth {
            reverse_proxy 127.0.0.1:9090 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up User-Agent {header.User-Agent}
                header_up Host {host}
                header_up X-Original-URI {uri}
            }
        }

        handle {
            reverse_proxy 127.0.0.1:9090 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up User-Agent {header.User-Agent}
                header_up Host {host}
                header_up X-Original-URI {uri}
            }
        }
    }
}