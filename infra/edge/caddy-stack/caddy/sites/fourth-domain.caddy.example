# CPA Usage Keeper domain. Replace hostname before use.
usage.example.com {
    log {
        level {$CADDY_LOG_LEVEL}
    }

    @scanner_bait {
        path /.env* /.git* /.svn* /.aws* /*config*.json /*.bak
        path /wp-admin* /wp-login.php /xmlrpc.php /admin* /administrator* /phpmyadmin* /pma*
        path /swagger* /v2/api-docs* /actuator* /graphql*
        path /cgi-bin* /console* /management.html /v0/management* /v0/resource/plugins*
    }

    handle @scanner_bait {
        reverse_proxy 127.0.0.1:9090 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up User-Agent {header.User-Agent}
            header_up Host {host}
            header_up X-Original-URI {uri}
        }
    }

    reverse_proxy 127.0.0.1:18080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}